# Development default. Production builds must set this to the HTTPS API origin.
# Vite inlines this at build time. Never put GEMINI_API_KEY here.
VITE_SPONSORGUARD_API_URL=http://127.0.0.1:8000

# Optional alias. VITE_SPONSORGUARD_API_URL wins if both are set.
# VITE_CREATORPREFLIGHT_API_URL=https://creatorpreflight-api.example.com
