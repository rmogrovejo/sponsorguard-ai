SPONSORGUARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPONSORGUARD_MAX_REQUEST_BODY_BYTES=2100000
SPONSORGUARD_SHORTFORM_MAX_UPLOAD_BYTES=25000000

# Optional: manual deterministic reviews work without these values.
