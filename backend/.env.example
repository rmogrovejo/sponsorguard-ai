# Copy to backend/.env and load with: uvicorn app.main:app --reload --env-file .env
# Never commit a real .env or API key.

# development | production
# Production requires SPONSORGUARD_ALLOWED_ORIGINS to be set explicitly.
CREATORPREFLIGHT_ENV=development

# Exact frontend origins. No wildcards. Comma-separated.
# Local defaults are used only when this is unset in development.
SPONSORGUARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JSON / transcript / brief request-body ceiling (bytes). Uploads use the Short-Form limit.
# Also set a matching reverse-proxy body limit (e.g. 30mb) in production.
SPONSORGUARD_MAX_REQUEST_BODY_BYTES=2100000
SPONSORGUARD_SHORTFORM_MAX_UPLOAD_BYTES=25000000

# Optional Gemini-backed features. Manual deterministic reviews work without these.
SPONSORGUARD_LLM_PROVIDER=gemini
SPONSORGUARD_LLM_MODEL=gemini-3.7-flash
SPONSORGUARD_LLM_TIMEOUT_SECONDS=20
SPONSORGUARD_SEMANTIC_TIMEOUT_SECONDS=60
GEMINI_API_KEY=your-gemini-api-key-here

# Optional YouTube Data API key for Audience Pulse URL mode (backend only).
# Manual comment paste works without this. Never put this in Vite/frontend env.
YOUTUBE_API_KEY=your-youtube-api-key-here
SPONSORGUARD_YOUTUBE_TIMEOUT_SECONDS=20

# Process-local sliding windows. Honest for a single Uvicorn worker only.
SPONSORGUARD_RATE_LIMIT_EXPENSIVE_PER_MINUTE=8
SPONSORGUARD_RATE_LIMIT_STANDARD_PER_MINUTE=40
SPONSORGUARD_RATE_LIMIT_WINDOW_SECONDS=60
SPONSORGUARD_RATE_LIMIT_MAX_KEYS=4096

# Opt-in live provider tests only. Do not set this in CI.
# CREATORPREFLIGHT_LIVE_GEMINI=1
